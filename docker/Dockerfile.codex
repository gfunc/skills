# gfunc-rig-codex: Codex CLI layer. Pinned to the migration floor.
FROM gfunc-rig-base:latest

ARG CODEX_VERSION=0.163.0
RUN npm install -g --no-fund --no-audit "@openai/codex@${CODEX_VERSION}" \
 && codex --version

COPY rig /opt/rig/rig
COPY mock-llm /opt/rig/mock-llm
ENTRYPOINT ["/opt/rig/rig/validate.sh"]
