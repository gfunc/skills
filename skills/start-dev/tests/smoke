def author_plan(text: str, edits: list[tuple[str, str]]) -> tuple[str, list[str]]:
    """Apply anchored skeleton edits; report any anchor that no longer resolves."""

    missing = []
    for old, new in edits:
        if old not in text:
            missing.append(old)
            continue
        text = text.replace(old, new)
    return text, missing


def cli_pr_section() -> str:
    """The second PR section: a cli surface the verification gate unblocks."""

    lanes = [
