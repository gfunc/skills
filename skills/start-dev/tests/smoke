        check(evidence.is_file(), "feature ledger written with wave gate, feature gate, and review/fix rows")

        logs = repo / ".scratch" / "demo" / "logs"
        logs.mkdir(parents=True, exist_ok=True)
        (logs / "wave-1.log").write_text("exit 0\nsrc/alpha.txt\nsrc/beta.txt\n")
        (logs / "feature-gate.log").write_text("exit 0\nall checks\n")
        (logs / "review-1.md").write_text("finding: missing newline at EOF in src/alpha.txt\n")

        for task in tasks:
            lane = repo / ".scratch" / "demo" / "lanes" / task["id"]
            target = lane / task["file"]
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(f"{task['id']}\n")
            git(["add", task["file"]], lane)
            commit = git(["commit", "-qm", f"task {task['id']}"], lane)
            check(commit.returncode == 0, f"task {task['id']} commits in its own lane", commit.stderr.strip()[:80])

        pr_branch = "pr/demo-1"
        pr = git(["checkout", "-q", "-b", pr_branch, "main"], repo)
        check(pr.returncode == 0, "PR branch created from main")
        merges = [git(["merge", "-q", "--no-ff", t["branch"], "-m", f"merge {t['id']}"], repo) for t in tasks]
        check(all(m.returncode == 0 for m in merges), "merge worker integrates both task commits",
              "; ".join(m.stderr.strip()[:60] for m in merges))
        for task in tasks:
            present = (repo / task["file"]).is_file()
            check(present, f"merged lane content present on the PR branch ({task['file']})")
        writers = subprocess.run(["git", "log", "--format=%an", pr_branch], cwd=repo,
                                 capture_output=True, text=True).stdout.splitlines()
        check(writers.count("smoke") == 5, "PR branch carries the init, two task, and two merge commits under repo-local identity", str(writers))

        program_ledger = repo / ".scratch" / "demo" / "program.md"
        feature_tsv = repo / ".scratch" / "demo" / "features" / "F1" / "tickets.tsv"
        feature_tsv.write_text("id\ttitle\tfile_lane\tedges\tsurface\tstate\nP1\ttwo atomic tasks\tsrc/**\tnone\tlibrary\tmerged\n")
        decisions = repo / ".scratch" / "demo" / "decisions.tsv"
        agents = repo / ".scratch" / "demo" / "agents.tsv"

        for path, label in [
            (program_ledger, "program ledger"), (repo / ".scratch/demo/features.tsv", "features.tsv"),
            (evidence, "feature run ledger"), (feature_tsv, "ticket tsv"),
            (decisions, "decisions.tsv"), (agents, "agents.tsv"),
        ]:
            check(path.is_file() and path.stat().st_size > 0, f"{label} exists and is nonempty")

        wave_log = (logs / "wave-1.log").read_text()
        check("exit 0" in wave_log, "wave gate evidence records the exit code")
        review = (logs / "review-1.md").read_text()
        fix = repo / ".scratch" / "demo" / "logs" / "fix-1.md"
        fix.write_text("fixed: newline added in src/alpha.txt; recheck: high-risk only\n")
        check("finding" in review and fix.is_file(), "review recorded one finding and the fix pass recorded its fix")

        run_md = evidence.read_text()
        for needle, label in [
            ("wave-1", "wave gate row"), ("| t2 | feature |", "feature gate row"),
            ("reviewer-A", "reviewer row"), ("fixer-A", "fixer row"),
            ("| PASS |", "review-lead verdict row"),
        ]:
            check(needle in run_md, f"feature ledger carries the {label}")

        tracked = git(["status", "--porcelain"], repo).stdout.strip()
        check(tracked == "", "scratch artifacts stay untracked (.scratch gitignored)", tracked[:80])

        elapsed = time.time() - t0
        print(f"\nsmoke completed in {elapsed:.1f}s")
        if FAILURES:
            print(f"SMOKE FAIL ({len(FAILURES)}):")
            for failure in FAILURES:
                print(f"  - {failure}")
            return 1
        print("SMOKE OK structural artifacts: ledgers, evidence, and portable fallback")
        return 0
    finally:
        for task_dir in (repo / ".scratch" / "demo" / "lanes").glob("*") if (repo / ".scratch" / "demo" / "lanes").is_dir() else []:
            git(["worktree", "remove", "--force", str(task_dir)], repo)
        if not keep:
            shutil.rmtree(repo, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main())
