        "Drive the entry's load-bearing journey under a loaded cart at trunk and head. "
        "Log `lane-1.log`. Pass when the totals match."
    ]
    for i in range(2, 11):
        lanes.append(
            f"- [ ] Lane {i}. `cli-checkout#journey-{i}`. Drive the entry's journey "
            f"under condition {i}. Log `lane-{i}.log`. Pass when the journey evidence exists."
        )
    lane_text = "\n".join(lanes)
    return f"""## Add the checkout CLI (PR 2)

