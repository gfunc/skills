def check(condition: bool, label: str, detail: str = "") -> None:
    if condition:
        print(f"  ok {label}")
    else:
        FAILURES.append(f"{label}{': ' + detail if detail else ''}")
        print(f"  FAIL {label} {detail}")


def run(cmd: list[str], cwd: Path | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)


def git(args: list[str], cwd: Path) -> subprocess.CompletedProcess:
    return run(["git", *args], cwd)


def write_ledgers(repo: Path, effort: str) -> None:
    """Initialize the layered ledger from the pack's templates and drive one run."""

    root = repo / ".scratch" / effort
    (root / "features" / "F1").mkdir(parents=True, exist_ok=True)

    (root / "program.md").write_text(
        "# demo-program run ledger\n\n"
        "Run root: `.scratch/demo/`\n"
        "Standing orders: `skills/start-dev/references/standing-orders.md`\n\n"
        "## Features\n\n"
        "| id | title | state | owner | updated |\n|---|---|---|---|---|\n"
        "| F1 | demo-feature | in-progress | main | t0 |\n"
    )
    (root / "features.tsv").write_text(
        "id\ttitle\tstate\towner\tupdated\nF1\tdemo-feature\tin-progress\tmain\tt0\n"
    )
    (root / "decisions.tsv").write_text("date\tdecision\tevidence\nt0\trouter selected feature layer\tone feature, two atomic tasks\n")
    (root / "agents.tsv").write_text("id\trole\tstate\tstuck_after\nPR-OWNER-1\tpoteto-agent pr-owner\trunning\t-\n")


def dispatch_wave(repo: Path, effort: str, tasks: list[dict]) -> dict:
    """Dispatch one wave of atomic tasks concurrently; one commit per task lane."""

    root = repo / ".scratch" / effort
    lanes = root / "lanes"
    lanes.mkdir(parents=True, exist_ok=True)
    started = {}
    for task in tasks:
        lane = lanes / task["id"]
        if lane.exists():
            shutil.rmtree(lane)
        result = git(["worktree", "add", str(lane.resolve()), "-b", task["branch"], "main"], repo)
        started[task["id"]] = result.returncode
    return started


