#!/usr/bin/env python3
"""start-dev structural smoke: drive the workflow's file-moving machinery in a scratch repo.

Builds a synthetic spec, stamps the authoring shell with emit-plan, proves the
unauthored shell is rejected, validates the authored plan with check-plan,
rejects a wave subgraph as a negative control, creates the feature worktree and
one unit worktree, commits the unit, merges it through the single-writer path,
and writes the run ledger.

This exercises the workflow's artifacts and tools, not the skill or a model.
No agent runs, no skill is loaded, and no model is called. Live model-backed
behavior is a separate manual check. Exit 0 only when every assertion holds.

Usage: skills/start-dev/tests/smoke [--keep]
"""

from __future__ import annotations

import argparse
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

PACK_ROOT = Path(__file__).resolve().parents[3]
SKILL = PACK_ROOT / "skills" / "start-dev"
FIXTURE = SKILL / "tests" / "fixtures" / "valid-plan.md"

FAILURES: list[str] = []


def check(condition: bool, label: str, detail: str = "") -> None:
    if condition:
        print(f"  ok {label}")
    else:
        FAILURES.append(f"{label}{': ' + detail if detail else ''}")
        print(f"  FAIL {label} {detail}")


def run(cmd: list[str], cwd: Path | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)


def git(args: list[str], cwd: Path) -> subprocess.CompletedProcess:
    return run(["git", *args], cwd)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--keep", action="store_true", help="keep the scratch repo for inspection")
    args = parser.parse_args()

    t0 = time.time()
    repo = Path(tempfile.mkdtemp(prefix="start-dev-smoke-"))
    keep = args.keep
    worktrees: list[Path] = []
    try:
        print(f"scratch repo {repo}")
        result = git(["init", "-q", "-b", "main"], repo)
        check(result.returncode == 0, "git init", result.stderr.strip())
        git(["config", "user.email", "smoke@example"], repo)
        git(["config", "user.name", "smoke"], repo)
        (repo / ".gitignore").write_text(".scratch/\n")
        git(["add", ".gitignore"], repo)
        git(["commit", "-qm", "init"], repo)

        spec_dir = repo / ".scratch" / "demo"
        spec_dir.mkdir(parents=True)
        (spec_dir / "spec.md").write_text(
            "# demo spec\n\nOne PR, two units on disjoint file lanes, one final gate, one review and one fix round.\n"
        )
        check((spec_dir / "spec.md").is_file(), "synthetic spec written")

        emit = run(
            ["node", str(SKILL / "scripts" / "emit-plan"), "--feature", "demo",
             "--title", "Demo", "--surface", "cli", "--pr", "P1",
             "--out", str(spec_dir / "plan.md")],
            repo,
        )
        check(emit.returncode == 0, "emit-plan stamps the plan", emit.stderr.strip()[:120])
        check((spec_dir / "plan.md").is_file(), "plan.md exists at the run root")
        shell = (spec_dir / "plan.md").read_text()
        for needle, label in [
            ("## How to read this", "the How to read this section"),
            ("## Verification readiness", "the readiness section"),
            ("## Run graph", "the Run graph section"),
            ("| Unit | Deliverable | File lane | Worktree | Scoped tests | Depends on |", "the lane table"),
            ("## Close the run", "the Close the run section"),
            ("## Appendix A. Prototype evidence", "the first appendix"),
            ("The root never pushes. Owners push only their own branch.", "standing order 12 in the register"),
        ]:
            check(needle in shell, f"emitted shell carries {label}")
        check("subgraph W" not in shell, "emitted shell carries no wave subgraph")
        check("Continuation: " in shell, "emitted shell carries the profile-named Continuation line")

        skeleton_check = run(
            ["node", str(SKILL / "scripts" / "check-plan.mjs"), str(spec_dir / "plan.md")], repo
        )
        check(skeleton_check.returncode == 1, "check-plan rejects the unauthored shell",
              f"exit {skeleton_check.returncode}")
        check("placeholder" in skeleton_check.stderr.lower() or "unit node" in skeleton_check.stderr.lower(),
              "the rejection names the missing authored content", skeleton_check.stderr.strip()[:160])

        authored = spec_dir / "plan-authored.md"
        shutil.copyfile(FIXTURE, authored)
        authored_check = run(
            ["node", str(SKILL / "scripts" / "check-plan.mjs"), str(authored)], repo
        )
        check(authored_check.returncode == 0, "check-plan accepts the authored plan",
              authored_check.stderr.strip()[:200])
        summary = next((ln for ln in authored_check.stdout.splitlines() if "PR sections" in ln), "")
        check("1 PR sections, 0 problems" in summary, "checker reports one clean PR section", summary)

        mutated = spec_dir / "plan-mutated.md"
        mutated.write_text(authored.read_text().replace("graph TD", "graph TD\n  subgraph W1[Wave 1]"))
        mutated_check = run(
            ["node", str(SKILL / "scripts" / "check-plan.mjs"), str(mutated)], repo
        )
        check(mutated_check.returncode == 1, "check-plan rejects a wave subgraph",
              f"exit {mutated_check.returncode}")
        check("wave subgraphs are retired" in mutated_check.stderr,
              "the rejection names the wave rule", mutated_check.stderr.strip()[:160])

        lanes = spec_dir / "lanes"
        lanes.mkdir(parents=True)
        feature = lanes / "feature"
        feature_add = git(["worktree", "add", str(feature), "-b", "pr/demo-1", "main"], repo)
        check(feature_add.returncode == 0, "feature worktree created on the PR branch",
              feature_add.stderr.strip()[:120])
        worktrees.append(feature)

        head = git(["rev-parse", "HEAD"], feature).stdout.strip()
        unit = lanes / "unit-U1"
        unit_add = git(["worktree", "add", str(unit), "-b", "unit/U1", head], repo)
        check(unit_add.returncode == 0, "unit worktree branched from the feature head",
              unit_add.stderr.strip()[:120])
        worktrees.append(unit)

        target = unit / "src" / "alpha.txt"
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text("U1\n")
        git(["add", "src/alpha.txt"], unit)
        commit = git(["commit", "-qm", "unit U1"], unit)
        check(commit.returncode == 0, "the unit commits in its own worktree", commit.stderr.strip()[:80])
        check(not (feature / "src" / "alpha.txt").exists(),
              "the PR branch is untouched before the merge")

        merge = git(["merge", "-q", "--no-ff", "unit/U1", "-m", "merge U1"], feature)
        check(merge.returncode == 0, "the merge worker integrates the unit",
              merge.stderr.strip()[:80])
        check((feature / "src" / "alpha.txt").is_file(),
              "merged unit content is present on the PR branch")
        mergesha = git(["rev-parse", "--short", "HEAD"], feature).stdout.strip()

        root = spec_dir
        (root / "decisions.tsv").write_text(
            "date\tdecision\tevidence\nt0\tone PR, two units\tplan.md\n"
        )
        (root / "agents.tsv").write_text("id\trole\tspawned_as\tmodel\tstate\tstuck_after\nU1\tdev\tcoder\tsmoke-model\tmerged\t-\n")
        (root / "progress.md").write_text(
            f"Run demo: armed (plan {authored.name}, plugin 0.6.0)\n"
            f"Unit U1: merged (commits {head[:7]}..{mergesha}, evidence .scratch/demo/logs/U1.log)\n"
        )
        (root / "run.md").write_text(
            "# demo run\n\n"
            f"Run root: `.scratch/demo/`\nPlan: `.scratch/demo/{authored.name}`\nProgress log: `.scratch/demo/progress.md`\n\n"
            "## PR\n\n"
            "| id | branch | url | owner | state | merged sha |\n|---|---|---|---|---|---|\n"
            f"| P1 | pr/demo-1 | pending | main | merged | {mergesha} |\n\n"
            "## Units\n\n"
            "| id | title | file lane | worktree | scoped test | dependencies | state | merge sha |\n"
            "|---|---|---|---|---|---|---|---|\n"
            f"| U1 | alpha | src/alpha.txt | .scratch/demo/lanes/unit-U1 | cat src/alpha.txt | none | merged | {mergesha} |\n\n"
            "## Gates\n\n"
            "| date | gate | command | exit | evidence |\n|---|---|---|---|---|\n"
            "| t1 | unit U1 | cat src/alpha.txt | 0 | logs/U1.log |\n\n"
            "## Review and fix\n\n"
            "| round | reviewer | findings | fixer | fixed | rechecked |\n|---|---|---|---|---|---|\n"
            "| 1 | reviewer-A | 0 | merge worker | 0 | n/a |\n"
        )
        logs = root / "logs"
        logs.mkdir()
        (logs / "U1.log").write_text("exit 0\nU1\n")

        for path, label in [
            (root / "run.md", "run ledger"),
            (root / "progress.md", "progress log"),
            (root / "decisions.tsv", "decision trail"),
            (root / "agents.tsv", "agent registry"),
            (logs / "U1.log", "unit gate evidence"),
        ]:
            check(path.is_file() and path.stat().st_size > 0, f"{label} exists and is nonempty")

        run_md = (root / "run.md").read_text()
        for needle, label in [
            ("| U1 |", "unit row"),
            ("| t1 | unit U1 |", "unit gate row"),
            ("reviewer-A", "reviewer row"),
            (mergesha, "merge SHA"),
        ]:
            check(needle in run_md, f"run ledger carries the {label}")

        tracked = git(["status", "--porcelain"], repo).stdout.strip()
        check(tracked == "", "scratch artifacts stay untracked (.scratch gitignored)", tracked[:80])

        elapsed = time.time() - t0
        print(f"\nsmoke completed in {elapsed:.1f}s")
        if FAILURES:
            print(f"SMOKE FAIL ({len(FAILURES)}):")
            for failure in FAILURES:
                print(f"  - {failure}")
            return 1
        print("SMOKE OK structural artifacts: shell, checker, unit merge, and run ledger")
        return 0
    finally:
        for tree in reversed(worktrees):
            git(["worktree", "remove", "--force", str(tree)], repo)
        if not keep:
            shutil.rmtree(repo, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main())
