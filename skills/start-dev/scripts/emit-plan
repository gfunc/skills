#!/usr/bin/env node
// Renders the authoring shell from the one shape statement. Every block, order and
// placeholder comes from ../references/plan-shape.mjs; this file only handles argv,
// the standing-orders register, and the output path.
import fs from "node:fs";
import path from "node:path";
import process from "node:process";
import { fileURLToPath } from "node:url";
import { renderShell, SURFACES } from "../references/plan-shape.mjs";

const USAGE = `Usage: node emit-plan --feature <slug> --title "<PR title>" --surface ui|cli|library|backend --pr <id> [--playbook single-pr] [--out <path>] [--force]`;

const scriptDir = path.dirname(fileURLToPath(import.meta.url));
const skillDir = path.dirname(scriptDir);
const registerPath = path.join(skillDir, "references", "standing-orders.md");

const args = process.argv.slice(2);
const flags = { playbook: "single-pr", force: false };
for (let i = 0; i < args.length; i++) {
	const arg = args[i];
	if (!arg.startsWith("--")) {
		console.error(`emit-plan: unexpected argument "${arg}"\n${USAGE}`);
		process.exit(2);
	}
	const name = arg.slice(2);
	if (name === "force") {
		flags.force = true;
		continue;
	}
	const value = args[++i];
	if (value === undefined || value.startsWith("--")) {
		console.error(`emit-plan: --${name} needs a value\n${USAGE}`);
		process.exit(2);
	}
	flags[name] = value;
}

for (const name of ["feature", "title", "surface", "pr"]) {
	if (!flags[name]) {
		console.error(`emit-plan: missing --${name}\n${USAGE}`);
		process.exit(2);
	}
}
if (!SURFACES.includes(flags.surface)) {
	console.error(`emit-plan: --surface must be one of ${SURFACES.join("|")}, got "${flags.surface}"\n${USAGE}`);
	process.exit(2);
}

let register;
try {
	register = fs.readFileSync(registerPath, "utf8");
} catch (error) {
	console.error(`emit-plan: cannot read ${registerPath}: ${error.message}`);
	process.exit(1);
}

let plan;
try {
	plan = renderShell({
		feature: flags.feature,
		title: flags.title,
		surface: flags.surface,
		pr: flags.pr,
		playbook: flags.playbook,
		register,
	});
} catch (error) {
	console.error(`emit-plan: ${error.message}`);
	process.exit(1);
}

const out = flags.out
	? path.resolve(process.cwd(), flags.out)
	: path.resolve(process.cwd(), ".scratch", flags.feature, "plan.md");
if (fs.existsSync(out) && !flags.force) {
	console.error(`emit-plan: ${out} already exists; pass --force to overwrite`);
	process.exit(1);
}
fs.mkdirSync(path.dirname(out), { recursive: true });
fs.writeFileSync(out, plan);
console.log(out);
