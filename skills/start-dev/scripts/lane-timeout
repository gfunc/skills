#!/usr/bin/env node
// Runs one command in its own process group and kills that group when the
// deadline elapses. Exits with the command's status when the command finishes
// first. A foreground Bash timeout does not qualify: the harness moves a timed
// out command to the background.
import { spawn } from "node:child_process";
import process from "node:process";

const USAGE = "Usage: node lane-timeout --timeout <seconds> -- <command> [args...]";
const args = process.argv.slice(2);
const split = args.indexOf("--");
const timeoutFlag = args.indexOf("--timeout");
const seconds = timeoutFlag >= 0 ? Number(args[timeoutFlag + 1]) : NaN;
if (split < 0 || !Number.isInteger(seconds) || seconds < 1 || split < timeoutFlag) {
	console.error(USAGE);
	process.exit(2);
}
const command = args.slice(split + 1);
if (!command.length) {
	console.error(USAGE);
	process.exit(2);
}

const child = spawn(command[0], command.slice(1), { stdio: "inherit", detached: true });
let settled = false;
const deadline = setTimeout(() => {
	if (settled) return;
	settled = true;
	try { process.kill(-child.pid, "SIGKILL"); } catch { /* already gone */ }
	process.exit(124);
}, seconds * 1000);
deadline.unref?.();

child.on("error", (error) => {
	if (settled) return;
	settled = true;
	clearTimeout(deadline);
	console.error(`lane-timeout: ${error.message}`);
	process.exit(127);
});
child.on("exit", (code, signal) => {
	if (settled) return;
	settled = true;
	clearTimeout(deadline);
	process.exit(code ?? (signal ? 128 : 1));
});
