#!/usr/bin/env python3
"""Check pack metadata, tracked boundaries, supported local Markdown links, and the Kimi harness profile's required sections."""

import sys
sys.dont_write_bytecode = True

import argparse
import json
from pathlib import Path
import re
import subprocess
import unicodedata
from urllib.parse import unquote, urlsplit

from frozen_skills import check_frozen_skills
from release_lib import ReleaseError, agreed_version, manifest_snapshots, repository_root


LIMITS = (
    "Markdown checks cover inline links, full/collapsed references, ATX/setext headings, "
    "and explicit HTML id/name anchors; fenced code and inline code are excluded. "
    "Frontmatter checks cover plain/quoted name/description strings and indented literal/folded blocks, not general YAML validity. "
    "Dynamic/template destinations, HTML links, shortcut references, and other Markdown extensions are not validated."
)


KIMI_PROFILE = "references/harnesses/kimi.md"
KIMI_PROFILE_SECTIONS = (
    "## Waiting and notifications",
    "## Goal mode",
    "## Plan mode",
    "## Cost and context",
)


def prose(text: str, *, keep_inline: bool = False) -> str:
    result = []
    fence = None
    for line in text.splitlines():
        match = re.match(r"^ {0,3}(`{3,}|~{3,})(.*)$", line)
        if fence:
            if match and match[1][0] == fence[0] and len(match[1]) >= fence[1] and not match[2].strip():
                fence = None
            result.append("")
        elif match:
            fence = (match[1][0], len(match[1]))
            result.append("")
        else:
            result.append(line if keep_inline else re.sub(r"(`+)(.*?)\1", lambda m: " " * len(m[0]), line))
    return "\n".join(result)


def anchors(text: str) -> set[str]:
    text = prose(text, keep_inline=True)
    found = set(re.findall(r"<(?:[\w-]+)\b[^>]*\b(?:id|name)=[\"']([^\"']+)[\"']", text, re.I))
    counts = {}
    lines = text.splitlines()
    for index, line in enumerate(lines):
        heading = re.match(r"^ {0,3}#{1,6}\s+(.+?)\s*#*\s*$", line)
        title = heading[1] if heading else None
        if title is None and index + 1 < len(lines) and line.strip() and re.fullmatch(r" {0,3}(?:=+|-+)\s*", lines[index + 1]):
            title = line.strip()
        if title is None:
            continue
        title = re.sub(r"<[^>]+>", "", title)
        title = re.sub(r"!?\[([^]]*)\]\([^)]*\)", r"\1", title)
        slug = "".join(c for c in title.lower() if c in " -_" or unicodedata.category(c)[0] in "LN")
        slug = slug.replace(" ", "-")
        count = counts.get(slug, 0)
        candidate = slug if count == 0 else f"{slug}-{count}"
        while candidate in found:
            count += 1
            candidate = f"{slug}-{count}"
        counts[slug] = count + 1
        found.add(candidate)
    return found


def destination(value: str) -> str | None:
    value = value.strip()
    if value.startswith("<"):
        end = value.find(">")
        if end < 0:
            return None
        target, rest = value[1:end], value[end + 1:].strip()
    else:
        match = re.match(r"(\S+)(?:\s+(.+))?$", value)
        if not match:
            return None
        target, rest = match[1], match[2] or ""
    if rest and not re.fullmatch(r'''(?:"[^"]*"|'[^']*'|\([^)]*\))''', rest):
        return None
    return re.sub(r"\\([\\()[\] ])", r"\1", target)


def links(text: str) -> tuple[list[tuple[int, str]], list[str]]:
    text = prose(text)
    found = []
    limits = []
    definitions = {}
    for number, line in enumerate(text.splitlines(), 1):
        match = re.match(r"^ {0,3}\[([^]]+)\]:\s*(.+)$", line)
        if match:
            target = destination(match[2])
            if target is None:
                limits.append(f"line {number}: unsupported reference definition")
            else:
                definitions[" ".join(match[1].lower().split())] = target
                found.append((number, target))
    for number, line in enumerate(text.splitlines(), 1):
        if re.match(r"^ {0,3}\[[^]]+\]:", line):
            continue
        for match in re.finditer(r"!?\[[^]\n]*\]\(", line):
            index, depth = match.end(), 1
            start = index
            while index < len(line) and depth:
                if line[index] == "\\":
                    index += 2
                    continue
                if line[index] == "(":
                    depth += 1
                elif line[index] == ")":
                    depth -= 1
                index += 1
            target = destination(line[start:index - 1]) if depth == 0 else None
            if target is None:
                limits.append(f"line {number}: unsupported inline destination")
            else:
                found.append((number, target))
        for match in re.finditer(r"!?\[([^]\n]+)\]\[([^]\n]*)\]", line):
            key = " ".join((match[2] or match[1]).lower().split())
            if key in definitions:
                found.append((number, definitions[key]))
            else:
                raise ReleaseError(f"line {number}: undefined link reference {key!r}")
    return found, limits


def skill_metadata(path: Path) -> None:
    text = path.read_text(encoding="utf-8")
    lines = text.splitlines()
    if not lines or lines[0] != "---" or "---" not in lines[1:]:
        raise ReleaseError("missing YAML frontmatter delimiters")
    front = lines[1:lines[1:].index("---") + 1]
    for key in ("name", "description"):
        entries = [(index, line.split(":", 1)[1].strip()) for index, line in enumerate(front)
                   if re.match(rf"^{key}\s*:", line)]
        if len(entries) != 1 or not entries[0][1]:
            raise ReleaseError(f"expected one nonempty scalar {key} in frontmatter")
        index, value = entries[0]
        if value in ("|", "|-", "|+", ">", ">-", ">+"):
            block = []
            for line in front[index + 1:]:
                if line and not line.startswith(" "):
                    break
                block.append(line.strip())
            value = "\n".join(block)
        elif value.startswith('"'):
            try:
                value = json.loads(value)
            except ValueError as error:
                raise ReleaseError(f"invalid quoted {key}: {error}") from error
        elif value.startswith("'"):
            if not re.fullmatch(r"'(?:[^']|'')*'", value):
                raise ReleaseError(f"invalid single-quoted {key}")
            value = value[1:-1].replace("''", "'")
        elif value[0] in "|>[{&*!" or ": " in value or " #" in value:
            raise ReleaseError(f"unsupported {key}; use a single-line plain or quoted scalar")
        elif value.lower() in ("null", "~", "true", "false") or value.isdecimal():
            raise ReleaseError(f"{key} must be a string")
        if not isinstance(value, str) or not value.strip():
            raise ReleaseError(f"{key} must be a nonempty string")


def agent_parity(root: Path) -> list[str]:
    # start-dev's owner agent ships as Markdown for Claude/Cursor/Kimi and TOML
    # for Codex. The two must stay in step: same name, and the TOML exists.
    # A pack that does not ship start-dev has no owner agent to check.
    if not (root / "skills" / "start-dev" / "SKILL.md").is_file():
        return []
    problems = []
    md = root / "agents" / "dev-owner.md"
    toml = root / "codex-agents" / "dev-owner.toml"
    if not md.is_file():
        problems.append("agents/dev-owner.md: missing start-dev owner agent")
        return problems
    if not toml.is_file():
        problems.append("codex-agents/dev-owner.toml: missing Codex port of the dev-owner agent")
        return problems
    md_text = md.read_text(encoding="utf-8")
    toml_text = toml.read_text(encoding="utf-8")
    md_name = next((line.split(":", 1)[1].strip() for line in md_text.splitlines() if line.startswith("name:")), "")
    toml_name = next((line.split("=", 1)[1].strip().strip('"') for line in toml_text.splitlines() if line.startswith("name =")), "")
    if md_name != toml_name:
        problems.append(f"dev-owner name mismatch: agents/dev-owner.md has {md_name!r}, codex-agents/dev-owner.toml has {toml_name!r}")
    for needle in ("skills/start-dev/SKILL.md", "references/roles/pr-owner.md"):
        if needle not in md_text:
            problems.append(f"agents/dev-owner.md: missing required read path {needle}")
        if needle not in toml_text:
            problems.append(f"codex-agents/dev-owner.toml: missing required read path {needle}")
    if "subagents:" not in md_text:
        problems.append("agents/dev-owner.md: missing the subagents child-type allowlist")
    return problems


def profile_contract(root: Path) -> list[str]:
    # The Kimi profile alone carries the sections the adapter contract depends
    # on; other harness profiles keep their own shape. A pack with no Kimi
    # profile at all is the installer's failure to name, not this check's.
    path = root / KIMI_PROFILE
    if not path.is_file():
        return []
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        return [f"{KIMI_PROFILE}: {error}"]
    headings = {line.strip() for line in prose(text).splitlines()
                if re.match(r"#{1,6}\s", line.strip())}
    return [f"{KIMI_PROFILE}: missing section {section}"
            for section in KIMI_PROFILE_SECTIONS if section not in headings]


def check(root: Path) -> tuple[list[str], list[str]]:
    errors = []
    limits = [LIMITS]
    snapshots = manifest_snapshots(root)
    version = agreed_version(snapshots)
    for snapshot in snapshots:
        data = json.loads(snapshot.original)
        for key in ("name", "description", "license"):
            if not isinstance(data.get(key), str) or not data[key].strip():
                errors.append(f"{snapshot.path.relative_to(root)}: missing string {key}")
        for key in ("hooks", "skills", "agents", "rules", "systemPromptPath", "logo"):
            if key not in data:
                continue
            if not isinstance(data[key], str):
                errors.append(f"{snapshot.path.relative_to(root)}: expected local string {key}")
                continue
            target = root / data[key]
            if not target.resolve().is_relative_to(root) or not target.exists():
                errors.append(f"{snapshot.path.relative_to(root)}: invalid local {key} {data[key]!r}")
    process = subprocess.run(["git", "-C", str(root), "ls-files", "-z", "--cached"], capture_output=True, text=True)
    if process.returncode:
        raise ReleaseError(f"cannot inspect tracked archive boundaries: {process.stderr.strip()}")
    tracked = set(filter(None, process.stdout.split("\0")))
    blocked = {".scratch", ".kimi-code", ".git", "node_modules", "__pycache__", ".venv"}
    anchor_cache = {}
    for name in sorted(tracked):
        path = root / name
        if set(path.relative_to(root).parts) & blocked or path.name in (".env", ".DS_Store") or path.suffix == ".pyc":
            errors.append(f"{name}: local runtime state must not be tracked in release archives")
        if not path.resolve().is_relative_to(root):
            errors.append(f"{name}: tracked path escapes repository")
            continue
        if not path.is_file():
            errors.append(f"{name}: tracked file missing or not a regular file")
            continue
        if name.startswith("skills/") and name.endswith("/SKILL.md"):
            try:
                skill_metadata(path)
            except (OSError, UnicodeError, ReleaseError) as error:
                errors.append(f"{name}: {error}")
        if not name.endswith(".md"):
            continue
        try:
            text = path.read_text(encoding="utf-8")
            local_links, skipped = links(text)
            source_lines = prose(text).splitlines()
            limits.extend(f"{name}: {limit}" for limit in skipped)
            for number, target in local_links:
                url = urlsplit(target)
                if url.scheme or url.netloc:
                    continue
                if not target or re.search(r"[{}<>$]", target):
                    limits.append(f"{name}:{number}: dynamic or empty destination {target!r}")
                    continue
                if re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]*", target) and re.search(r"\{[^{}\s]+\}", source_lines[number - 1]):
                    limits.append(f"{name}:{number}: template destination on a placeholder line {target!r}")
                    continue
                decoded = unquote(url.path)
                resolved = (path if not decoded else root / decoded.lstrip("/") if decoded.startswith("/") else path.parent / decoded).resolve()
                if not resolved.is_relative_to(root):
                    errors.append(f"{name}:{number}: local link escapes repository: {target}")
                elif not resolved.exists():
                    errors.append(f"{name}:{number}: missing local target {target}")
                elif resolved.is_file() and resolved.relative_to(root).as_posix() not in tracked:
                    errors.append(f"{name}:{number}: local target is not tracked: {target}")
                elif url.fragment:
                    if resolved.suffix.lower() != ".md":
                        limits.append(f"{name}:{number}: non-Markdown anchor {target!r}")
                        continue
                    if resolved not in anchor_cache:
                        anchor_cache[resolved] = anchors(resolved.read_text(encoding="utf-8"))
                    if unquote(url.fragment) not in anchor_cache[resolved]:
                        errors.append(f"{name}:{number}: missing local anchor {target}")
        except (OSError, UnicodeError, ValueError, ReleaseError) as error:
            errors.append(f"{name}: {error}")
    errors.extend(profile_contract(root))
    errors.extend(agent_parity(root))
    if (root / "references" / "frozen-skills.tsv").exists():
        errors.extend(check_frozen_skills(root))
    elif root.resolve() == Path(__file__).resolve().parents[1]:
        errors.append("references/frozen-skills.tsv: missing")
    else:
        limits.append("references/frozen-skills.tsv not present; Matt Pocock freeze check skipped")
    print(f"version {version.text}; inspected {len(tracked)} tracked files")
    return errors, limits


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", help="repository root to inspect without modifying it")
    args = parser.parse_args()
    try:
        errors, limits = check(repository_root(args.root))
        for limit in limits:
            print(f"LIMIT {limit}")
        for error in errors:
            print(f"FAIL {error}", file=sys.stderr)
        if not errors:
            print("OK pack metadata, supported local links, and tracked archive boundaries")
        return bool(errors)
    except (OSError, ReleaseError) as error:
        print(f"validate-pack: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
